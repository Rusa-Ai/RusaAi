{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSA AI A2A Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "task_id",
    "message_id",
    "type",
    "from",
    "to",
    "created_at",
    "task",
    "policy"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "task.create",
        "task.accepted",
        "task.status",
        "task.result",
        "task.blocked",
        "task.review",
        "task.cancel"
      ]
    },
    "from": {
      "$ref": "#/$defs/agent"
    },
    "to": {
      "$ref": "#/$defs/agent"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "acceptance_criteria",
        "repository",
        "base_branch",
        "work_branch"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "context": {
          "type": "string",
          "maxLength": 20000
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "work_branch": {
          "type": "string",
          "pattern": "^(feature|fix|chore|docs)/[A-Za-z0-9._/-]+$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "prohibited_actions",
        "human_approval_required"
      ],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_approval_required": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "merge",
              "deploy",
              "release",
              "secret_change",
              "permission_change",
              "destructive_action"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "in_progress",
        "submitted",
        "reviewing",
        "approved",
        "changes_requested",
        "blocked",
        "cancelled"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "uri"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "commit",
              "pull_request",
              "test_log",
              "build_log",
              "artifact",
              "review"
            ]
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{7,64}$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "role"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": [
            "human",
            "chatgpt_app",
            "rusa_orchestrator",
            "github_copilot"
          ]
        }
      }
    }
  }
}
